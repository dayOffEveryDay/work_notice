<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="28dp" android:fitsSystemWindows="true">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="工作警報" android:textSize="28sp" android:textStyle="bold" />
 <TextView android:id="@+id/recovery_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="請解鎖並保持此畫面可見，以確認播放資格。" android:paddingTop="24dp" android:textSize="18sp" />
 <Button android:id="@+id/recovery_stop" android:layout_width="match_parent" android:layout_height="72dp" android:text="停止目前響鈴" android:textSize="22sp" />
 <Button android:id="@+id/recovery_main" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看主畫面與未來警報設定" />
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="停止目前響鈴不會關閉未來新工作警報。若系統仍拒絕音訊焦點，備援通知會保留。" android:paddingTop="20dp" />
</LinearLayout>
